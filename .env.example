# Copy this file to .env before running Docker Compose. Replace every
# replace-with-* value; production startup rejects placeholders and short keys.

SECRET_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

POSTGRES_DB=gradebook
POSTGRES_USER=gradebook
POSTGRES_PASSWORD=replace-with-a-random-database-password

# Services are intentionally reachable only from this computer by default.
BIND_ADDRESS=127.0.0.1
DATABASE_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

CORS_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,backend

CANVAS_BASE_URL=
CANVAS_API_TOKEN=
CANVAS_ACCOUNT_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_TIMEZONE=America/Chicago
DAILY_SYNC_CRON=0 5 * * *
DAILY_BACKUP_CRON=30 5 * * *
LLM_DEIDENTIFY_DEFAULT=true
